# Copy to `app/crawler/.env` for local runs. Never commit .env.
# In GitHub Actions these come from repository secrets instead.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# service_role key (Settings -> API). Required for inserts: the table has RLS
# enabled with public SELECT only, so the anon key cannot write.
SUPABASE_SERVICE_ROLE_KEY=

# DeepL API key. Free-tier keys end with ":fx" and use api-free.deepl.com;
# Pro keys use api.deepl.com. 500k chars/month on the free plan.
DEEPL_API_KEY=

# Optional. Directory for the per-run log file (crawler_YYYYMMDD_HHMMSS.log).
# Only needed for local runs; defaults to <project-root>/log (two levels above
# app/crawler). In GitHub Actions the workflow reads logs from that default.
# LOG_DIR=
